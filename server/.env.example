# Copy to server/.env. Never commit or share the real file.
PORT=4000
# JWT_SECRET=replace-with-a-long-random-string
# TRUST_PROXY=1            # only when running behind a reverse proxy you control
# PUBLIC_URL=http://localhost:5173
# Password reset delivery: verified sender and HTTPS API key from Resend.
# RESEND_API_KEY=
# MAIL_FROM=Paydayly <reset@your-verified-domain.example>
# LOG_RESET_LINKS=true    # optional local development only; disabled in production

# Optional AI helper (Groq, OpenAI-compatible). Leave blank to keep it off.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# AI_DAILY_LIMIT=40
